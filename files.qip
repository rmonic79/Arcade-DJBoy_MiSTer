# —— audio cores (YM2203 jt03 + 2x OKI jt6295) ——
set_global_assignment -name QIP_FILE rtl/jt03/jt03.qip
set_global_assignment -name QIP_FILE rtl/jt6295/jt6295.qip
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_mixer.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_pole.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_sndchain.v

# —— DJ Boy game ——
set_global_assignment -name SYSTEMVERILOG_FILE rtl/djboy/djboy_dpram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/djboy/djboy_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/djboy/djboy_sdram_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/djboy/djboy_pandora.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/djboy/djboy_bg.sv

# —— SDRAM / PLL / jtframe glue ——
set_global_assignment -name VERILOG_FILE rtl/jtframe_sdram64.v
set_global_assignment -name VERILOG_FILE rtl/jtframe_sdram64_bank.v
set_global_assignment -name VERILOG_FILE rtl/jtframe_sdram64_init.v
set_global_assignment -name VERILOG_FILE rtl/jtframe_sdram64_latch.v
set_global_assignment -name VERILOG_FILE rtl/jtframe_sdram64_rfsh.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_frac_cen.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_freqinfo.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_sync.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_ram.v
set_global_assignment -name VERILOG_FILE rtl/jtframe/jtframe_dual_ram.v
set_global_assignment -name VERILOG_FILE rtl/pll.v
set_global_assignment -name QIP_FILE rtl/pll.qip
