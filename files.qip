# DJ Boy (Kaneko 1989) — project file list (sourced by the .qsf).
# Base: fork NightSlashers (jtframe_sdram64 multi-bank).
# HW: 3x Z80 @6MHz + MCU 8051 "BEAST" + Kaneko PANDORA + YM2203 + 2x OKI M6295.

# —— common infra (memory, savestate, overlays) ——
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/ddram_4port.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/savestate.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/savestate_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/savestate_ddr.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/memory_stream.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/ss_ddr_gate.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/savestate_ui.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/pause_overlay.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/pause_text.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/pause_font.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/common/analog_hsize.sv
set_global_assignment -name VERILOG_FILE rtl/common/hiscore.v

# —— CPU: 3x Z80 (tv80 instrumentato savestate; T80 VHDL disponibile come alternativa) ——
set_global_assignment -name VERILOG_FILE rtl/tv80/tv80_auto_ss.v
set_global_assignment -name VHDL_FILE rtl/t80/T80pa.vhd
set_global_assignment -name VHDL_FILE rtl/t80/T80s.vhd
set_global_assignment -name VHDL_FILE rtl/t80/T80.vhd
set_global_assignment -name VHDL_FILE rtl/t80/T80_ALU.vhd
set_global_assignment -name VHDL_FILE rtl/t80/T80_MCode.vhd
set_global_assignment -name VHDL_FILE rtl/t80/T80_Reg.vhd

# —— MCU 8051 BEAST (mc8051 Oregano + wrapper jtframe, ordine da mc8051.yaml) ——
set_global_assignment -name VERILOG_FILE rtl/mc8051/jtframe_8751mcu.v
set_global_assignment -name VHDL_FILE rtl/mc8051/mc8051_p.vhd
